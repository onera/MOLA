#!/usr/bin/env python3
#
# Read a file with workflow parameters and apply methods prepare() and write_cfd_files()

import sys

from treelab import cgns

from mola import __MOLA_PATH__
from mola import misc
from mola.logging import MolaException

err1 = 'must specify an input file name, e.g.: "mola_prepare workflow.cgns"'
if len(sys.argv) != 2: raise AttributeError(err1)
filename = str(sys.argv[1])

try:
    # Get the right class of Workflow
    tree = cgns.load(filename)
    workflow_name = tree.get(Name='WorkflowParameters').get(Name='Name', Depth=1).value()
    workflows = misc.load_source('workflows', f'{__MOLA_PATH__}/mola/workflow/__init__.py')
    PreviouslyUsedWorkflow = getattr(workflows, workflow_name)

    w = PreviouslyUsedWorkflow(tree=tree)
    w.prepare()  
    w.write_cfd_files()

except Exception as exception:
    with open('ERROR_PREPARING_WORKFLOW','w') as f: 
        f.write(str(exception))
    raise MolaException('Unable to prepare workflow')
